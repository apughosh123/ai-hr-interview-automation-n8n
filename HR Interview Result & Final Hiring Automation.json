    {
      "parameters": {
        "jsCode": "const score = Number($json.interview_score || 0);\nconst result = String($json.interview_result || '').trim().toUpperCase();\n\nlet finalDecision;\n\nif (result === 'PASS' && score >= 70) {\nfinalDecision = 'HIRED';\n} else {\nfinalDecision = 'REJECTED';\n}\n\nreturn [\n{\njson: {\n...$json,\nfinal_decision: finalDecision,\nfinal_decision_date: new Date().toISOString()\n}\n}\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
