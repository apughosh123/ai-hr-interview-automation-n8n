    {
      "parameters": {
        "jsCode": "const raw = $json.text || $json.output || $json.response || '';\n\nlet cleaned = raw\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error('AI returned invalid JSON: ' + error.message);\n}\n\nreturn {\n  json: {\n    ...parsed,\n    parsed_successfully: true\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -288
      ],
      "id": "94157f62-db92-4a5b-999e-82d93b1865de",
      "name": "Parse Resume Analysis"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\n// Target job from the intake stage\nconst targetJob =\n  $('Normalize Candidate Intake').first().json.job_title || '';\n\nconst job = String(targetJob).toLowerCase();\n\n// Safely handle extracted arrays\nconst skills = Array.isArray(data.skills) ? data.skills : [];\nconst projects = Array.isArray(data.projects) ? data.projects : [];\nconst education = Array.isArray(data.education) ? data.education : [];\nconst certifications = Array.isArray(data.certifications)\n  ? data.certifications\n  : [];\nconst evidence = Array.isArray(data.evidence) ? data.evidence : [];\nconst potentialGaps = Array.isArray(data.potential_gaps)\n  ? data.potential_gaps\n  : [];\n\n// --------------------------------------------------\n// 1. TECHNICAL SKILLS — MAX 30\n// --------------------------------------------------\n\nconst technicalKeywords = [\n  'javascript',\n  'html',\n  'css',\n  'react',\n  'tailwind',\n  'bootstrap',\n  'n8n',\n  'api',\n  'rest api',\n  'webhook',\n  'automation',\n  'ai',\n  'git',\n  'github',\n  'frontend',\n  'web development'\n];\n\nconst relevantSkills = skills.filter(skill => {\n  const skillText = String(skill).toLowerCase();\n\n  return technicalKeywords.some(keyword =>\n    skillText.includes(keyword)\n  );\n});\n\nconst technicalScore = Math.min(\n  30,\n  relevantSkills.length * 5\n);\n\n// --------------------------------------------------\n// 2. PROJECT / EXPERIENCE RELEVANCE — MAX 25\n// --------------------------------------------------\n\nconst relevantProjects = projects.filter(project => {\n  const projectText = JSON.stringify(project).toLowerCase();\n\n  if (\n    job.includes('frontend') ||\n    job.includes('web developer') ||\n    job.includes('software engineer')\n  ) {\n    return (\n      projectText.includes('frontend') ||\n      projectText.includes('web') ||\n      projectText.includes('html') ||\n      projectText.includes('css') ||\n      projectText.includes('javascript') ||\n      projectText.includes('react') ||\n      projectText.includes('tailwind') ||\n      projectText.includes('bootstrap')\n    );\n  }\n\n  if (\n    job.includes('automation') ||\n    job.includes('ai')\n  ) {\n    return (\n      projectText.includes('automation') ||\n      projectText.includes('ai') ||\n      projectText.includes('n8n') ||\n      projectText.includes('workflow')\n    );\n  }\n\n  return true;\n});\n\nconst projectScore = Math.min(\n  25,\n  relevantProjects.length * 8\n);\n\n// --------------------------------------------------\n// 3. EDUCATION — MAX 15\n// --------------------------------------------------\n\nconst educationScore =\n  education.length > 0 ? 15 : 0;\n\n// --------------------------------------------------\n// 4. CERTIFICATIONS — MAX 10\n// --------------------------------------------------\n\nconst certificationScore = Math.min(\n  10,\n  certifications.length * 5\n);\n\n// --------------------------------------------------\n// 5. EVIDENCE QUALITY — MAX 10\n// --------------------------------------------------\n\nconst evidenceScore = Math.min(\n  10,\n  evidence.length * 2\n);\n\n// --------------------------------------------------\n// TOTAL SCORE\n// --------------------------------------------------\n\nconst totalScore =\n  technicalScore +\n  projectScore +\n  educationScore +\n  certificationScore +\n  evidenceScore;\n\n// --------------------------------------------------\n// RECOMMENDATION\n// --------------------------------------------------\n\nlet status;\n\nif (totalScore >= 75) {\n  status = 'STRONG_MATCH';\n} else if (totalScore >= 55) {\n  status = 'POTENTIAL_MATCH';\n} else {\n  status = 'REVIEW_REQUIRED';\n}\n\n// --------------------------------------------------\n// HUMAN OVERSIGHT\n// --------------------------------------------------\n\nconst humanReviewRequired = true;\n\n// --------------------------------------------------\n// FINAL OUTPUT\n// --------------------------------------------------\n\nreturn {\n  json: {\n    candidate: data.candidate || {},\n    \n    target_job: targetJob,\n\n    screening_score: totalScore,\n\n    score_maximum: 90,\n\n    score_breakdown: {\n      technical_skills: {\n        score: technicalScore,\n        maximum: 30,\n        relevant_skills: relevantSkills\n      },\n\n      relevant_projects: {\n        score: projectScore,\n        maximum: 25,\n        relevant_project_count: relevantProjects.length,\n        projects: relevantProjects\n      },\n\n      education: {\n        score: educationScore,\n        maximum: 15\n      },\n\n      certifications: {\n        score: certificationScore,\n        maximum: 10,\n        certification_count: certifications.length\n      },\n\n      evidence_quality: {\n        score: evidenceScore,\n        maximum: 10,\n        evidence_count: evidence.length\n      }\n    },\n\n    strengths: evidence,\n\n    potential_gaps: potentialGaps,\n\n    recommendation: {\n      status: status,\n      reason:\n        status === 'STRONG_MATCH'\n          ? 'Strong evidence-based alignment with the target role.'\n          : status === 'POTENTIAL_MATCH'\n            ? 'Candidate shows relevant evidence but requires human review.'\n            : 'Insufficient evidence for automatic progression.'\n    },\n\n    governance: {\n      scoring_method: 'Deterministic evidence-based scoring',\n      ai_decision: false,\n      human_review_required: humanReviewRequired,\n      final_hiring_decision: 'Human decision required'\n    },\n\n    parsed_successfully: true\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        -288
      ],
      "id": "5633bf71-92c2-444a-93ce-8809e103d39e",
      "name": "Deterministic Candidate Scoring"
    },
